{
  "name": "medos",
  "version": "0.1.0",
  "private": true,
  "description": "MedOS â€” a personal medical-school study operating system.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @medos/web --",
    "build": "npm run build --workspace @medos/web --",
    "start": "npm run start --workspace @medos/web --",
    "check:production": "npm run check:production --workspace @medos/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace @medos/web --",
    "test:e2e:install": "npm run test:e2e:install --workspace @medos/web",
    "db:generate": "npm run db:generate --workspace @medos/database --",
    "db:check": "npm run db:check --workspace @medos/database",
    "db:migrate": "npm run db:migrate --workspace @medos/database",
    "db:seed": "npm run db:seed --workspace @medos/database",
    "db:studio": "npm run db:studio --workspace @medos/database --",
    "medos-sync": "npm run cli --workspace @medos/sync --",
    "auth:secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run db:check && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
