{
  "name": "@medos/database",
  "version": "0.1.0",
  "private": true,
  "description": "MedOS persistence: PostgreSQL schema, migrations, client and development seeds.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts",
    "./limits": "./src/limits.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@medos/fsrs": "*",
    "@medos/parsers": "*",
    "@medos/shared": "*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
