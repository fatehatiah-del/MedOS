# MedOS environment configuration
#
# Copy this file to apps/web/.env.local and adjust as needed.
# Real .env files are git-ignored. Never commit secrets.
#
# The web app validates its variables at startup (apps/web/src/env.ts).
# The database commands (npm run db:*) read DATABASE_URL from the same file.

# --- Active ------------------------------------------------------------------

# AI is optional and disabled by default. "none" is the only supported value.
AI_PROVIDER=none

# Public base URL of the deployment (optional in development).
# APP_URL=http://localhost:3000

# Where the database lives. Used by the database commands; the web app does
# not read it yet.
#
#   pglite:<directory>   Embedded PostgreSQL stored in a local folder. Needs no
#                        installation. Relative paths start at the repository
#                        root. Only one process can open it at a time.
#   postgres://…         A PostgreSQL server, local or hosted. Put the real
#                        connection string only in apps/web/.env.local.
DATABASE_URL=pglite:./.medos/pgdata

# --- Reserved for later phases (not read yet) --------------------------------

# Phase 3 — authentication provider (Supabase-compatible abstraction).
# AUTH_PROVIDER=
# AUTH_URL=
# AUTH_SECRET=

# Phase 5/6 — object storage (S3-compatible abstraction).
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
