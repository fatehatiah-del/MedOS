# MedOS environment configuration
#
# Copy this file to apps/web/.env.local and adjust as needed.
# Real .env files are git-ignored. Never commit secrets.
#
# Variables are validated at startup by apps/web/src/env.ts.

# --- Active in the current phase -------------------------------------------

# AI is optional and disabled by default. "none" is the only supported value.
AI_PROVIDER=none

# Public base URL of the deployment (optional in development).
# APP_URL=http://localhost:3000

# --- Reserved for later phases (not read yet) ------------------------------

# Phase 2 — PostgreSQL connection string.
# DATABASE_URL=

# Phase 3 — authentication provider (Supabase-compatible abstraction).
# AUTH_PROVIDER=
# AUTH_URL=
# AUTH_SECRET=

# Phase 5/6 — object storage (S3-compatible abstraction).
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
