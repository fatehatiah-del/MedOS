# MedOS environment configuration
#
# Copy this file to apps/web/.env.local and fill it in.
# Real .env files are git-ignored. Never commit secrets, and never put a
# secret in a variable whose name starts with NEXT_PUBLIC_.
#
# The web app and the database commands (npm run db:*) read the same file.

# --- Database ----------------------------------------------------------------

# Where the database lives.
#
#   pglite:<directory>   Embedded PostgreSQL stored in a local folder. Needs no
#                        installation. Relative paths start at the repository
#                        root. Only one process can open it at a time, so stop
#                        the dev server before running db:* commands.
#   postgres://…         A PostgreSQL server, local or hosted. Put the real
#                        connection string only in apps/web/.env.local.
DATABASE_URL=pglite:./.medos/pgdata

# --- Authentication ----------------------------------------------------------

# Signs session cookies. Required; at least 32 characters.
# Generate one with:  npm run auth:secret
AUTH_SECRET=

# Public address of the app, without a trailing slash. Optional in
# development; required in production, where it must be the real https:// URL.
# APP_URL=http://localhost:3000

# Google sign-in. Leave both empty to keep it switched off; the button is then
# shown as unavailable. See docs/google-auth-setup.md.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Optional. Comma-separated addresses that may create an account. When set,
# nobody else can, by either method. Recommended once the app is publicly
# reachable, since MedOS is a personal workspace.
# AUTH_ALLOWED_EMAILS=you@example.com

# --- MedOS Sync (local only) --------------------------------------------------

# Your study folder. It is only ever read. Example:
# MEDOS_SOURCE_DIR=C:\Users\yourname\Downloads\S5
# The email of the MedOS account to import into (sign up in the app first).
# MEDOS_SYNC_USER=you@example.com
# Where copies of original files are kept. Defaults to .medos/objects here.
# MEDOS_STORAGE_DIR=

# --- Development -------------------------------------------------------------

# Set to true to give an account with no weeks yet a set of placeholder weeks
# and lectures, labelled as development data. Leave unset in production and
# wherever real study material will be imported.
# DEV_FIXTURE_LECTURES=true

# --- Other -------------------------------------------------------------------

# AI is optional and disabled by default. "none" is the only supported value.
AI_PROVIDER=none

# --- Reserved for later phases (not read yet) --------------------------------

# Phase 5/6 — object storage (S3-compatible abstraction).
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
